generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                     String   @id @default(uuid())
  name                   String
  slug                   String   @unique
  phone                  String?
  specialty              String?
  bio                    String?
  logo                   String?
  qrCode                 String?
  address                String?
  latitude               Float?
  longitude              Float?
  createdAt DateTime @default(now())
  updatedAt              DateTime @updatedAt

  profiles           Profile[]
  patients           Patient[]
  appointments       Appointment[]
  patientFiles       PatientFile[]
  socialLinks        SocialLink[]
  services           Service[]
  invitations        Invitation[]
  cases              Case[]
  visitNotes         VisitNote[]
  transactions       Transaction[]
  clinicAvailability ClinicAvailability?
  recurringExpenses  RecurringExpense[]
  doctorUnavailable  DoctorUnavailable[]
  reminders          Reminder[]
  messageLogs        MessageLog[]
  subscription       Subscription?
  usageCounters      UsageCounter[]
}

enum PlanTier {
  STARTER
  PROFESSIONAL
  BUSINESS
  ENTERPRISE
}

enum PlanStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model Subscription {
  id                   String     @id @default(uuid())
  tenantId             String     @unique
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tier                 PlanTier   @default(STARTER)
  status               PlanStatus @default(TRIAL)
  currentPeriodEnd     DateTime?
  // Reserved for future Stripe migration — left nullable intentionally.
  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UsageCounter {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodMonth       String   // "YYYY-MM"
  appointmentsCount Int      @default(0)
  whatsappCount     Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, periodMonth])
  @@index([tenantId])
}

model SocialLink {
  id        String         @id @default(uuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform  SocialPlatform
  url       String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  TIKTOK
  X
  LINKEDIN
  YOUTUBE
}

model Profile {
  id        String   @id // Matches Supabase auth.users.id
  email     String   @unique
  firstName String?
  lastName  String?
  role      UserRole @default(DOCTOR)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  appointments        Appointment[] @relation("DoctorAppointments")
  doctorUnavailable   DoctorUnavailable[]
  sentInvitations     Invitation[]  @relation("SentInvitations")
  acceptedInvitations Invitation[]  @relation("AcceptedInvitations")
  patientFilesUploaded PatientFile[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
}

model Patient {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  email           String?
  phone           String?  
  dateOfBirth     DateTime?
  gender          Gender?
  status          String    @default("active")
  address         String?

  appointments  Appointment[]
  patientFiles  PatientFile[]
  cases         Case[]
  visitNotes    VisitNote[]
  transactions  Transaction[]
  messageLogs   MessageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firstName, lastName])
  @@unique([tenantId, phone])
}

enum Gender {
  MALE
  FEMALE
}

enum ReminderType {
  CONFIRM
  REMINDER
  RESCHEDULE
  CANCEL
}

enum MessageStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Service {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  duration    Int
  color       String
  price       Decimal?
  isActive    Boolean  @default(true)

  appointments Appointment[]

  transactions  Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClinicAvailability {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedule  Json
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DoctorUnavailable {
  id        String   @id @default(uuid())
  tenantId  String
  doctorId  String
  startTime DateTime
  endTime   DateTime
  reason    String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor    Profile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId, startTime])
  @@index([tenantId])
}

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Profile           @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Restrict)
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  caseId          String?
  case            Case?             @relation(fields: [caseId], references: [id], onDelete: SetNull)
  startTime       DateTime
  endTime         DateTime
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?

  visitNotes   VisitNote[]
  transactions Transaction[]
  messageLogs  MessageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AppointmentStatus {
  BOOKING
  WAITING
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model PatientFile {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  name        String
  storagePath String
  hash        String
  mimeType    String
  size        Int

  uploadedById String?
  uploadedBy   Profile? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  visitNoteLinks VisitNoteFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, tenantId])
  @@index([hash])
  @@index([tenantId, createdAt])
}

model VisitNoteFile {
  id          String      @id @default(uuid())
  tenantId    String
  visitNoteId String
  visitNote   VisitNote   @relation(fields: [visitNoteId], references: [id], onDelete: Cascade)
  fileId      String
  file        PatientFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([visitNoteId, fileId])
  @@index([fileId])
  @@index([tenantId, visitNoteId])
}

model Invitation {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String
  role            UserRole
  status          InvitationStatus @default(PENDING)
  invitedBy       String
  inviter         Profile          @relation("SentInvitations", fields: [invitedBy], references: [id], onDelete: Cascade)
  acceptedBy      String?
  acceptedProfile Profile?         @relation("AcceptedInvitations", fields: [acceptedBy], references: [id], onDelete: SetNull)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())

  @@index([email, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum CaseStatus {
  ACTIVE
  INACTIVE
}

model Case {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId    String
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       CaseStatus    @default(ACTIVE)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model VisitNote {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  content       String?      // free-text clinical notes
  diagnosis     String?
  medications   Medication[]
  notes         String?
  validityDays  Int?         @default(30)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  patientFiles VisitNoteFile[]

  @@index([patientId, tenantId])
  @@index([createdAt])
}

model Medication {
  id          String    @id @default(uuid())
  visitNoteId String
  visitNote   VisitNote @relation(fields: [visitNoteId], references: [id], onDelete: Cascade)
  name        String
  dose        String
  frequency   String
  duration    String
  instructions String?

  @@index([visitNoteId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  CONSULTATION
  MEDICATIONS
  SERVICES
  CLINIC_RENT
  INTERNET
  SALARIES
  UTILITIES
  SUPPLIES
  MARKETING
  INSURANCE
  TAXES
  MAINTENANCE
  OTHER
}

model Transaction {
  id            String              @id @default(uuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          TransactionType
  category      TransactionCategory
  amount        Decimal
  description   String?
  date          DateTime
  patientId     String?
  patient       Patient?            @relation(fields: [patientId], references: [id], onDelete: SetNull)
  appointmentId String?
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  serviceId     String?
  service       Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([tenantId, date])
  @@index([tenantId, category])
  @@index([appointmentId])
}

model RecurringExpense {
  id          String              @id @default(uuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    TransactionCategory
  amount      Decimal
  description String?
  notes       String?
  dayOfMonth  Int                 @default(1)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([tenantId, isActive])
}

model Reminder {
  id                   String       @id @default(uuid())
  tenantId             String
  tenant               Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                 ReminderType
  name                 String
  isActive             Boolean      @default(true)
  triggerBeforeMinutes Int?         // minutes before appointment start (for REMINDER type: 1440 = 24h)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  messageLogs MessageLog[]

  @@unique([tenantId, type])
}

model MessageLog {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reminderId    String?
  reminder      Reminder?     @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  type          ReminderType
  appointmentId String?
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientId     String?
  patient       Patient?      @relation(fields: [patientId], references: [id], onDelete: SetNull)
  toPhone       String
  messageContent String
  status        MessageStatus @default(QUEUED)
  externalId    String?       // WhatsApp message ID (wamid.xxx)
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  errorMessage  String?
  createdAt     DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([appointmentId])
  @@index([patientId])
  @@index([status])
}
